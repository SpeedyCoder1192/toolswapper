{
  "schemaVersion": 1,
  "id": "toolswapper",
  "version": "${version}",
  "name": "ToolSwapper",
  "description": "Automatic, obsessively configurable tool and weapon swapping for Fabric.",
  "authors": ["SCA"],
  "license": "MIT",
  "icon": "assets/toolswapper/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.sca.toolswapper.ToolSwapClient"],
    "modmenu": ["com.sca.toolswapper.compat.ModMenuIntegration"]
  },
  "mixins": [
    {
      "config": "toolswapper.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
